# Servidor (opcional; porta HTTP do backend = 38572. A 3000 foi liberada para o OneClick V2)
# PORT=38572

# IRPF 2026 – Área administrativa: apenas estes e-mails podem acessar /irpf-2026/admin (separados por vírgula).
# Se não definir, usa o padrão: ti@central-rnc.com.br, marcelo@central-rnc.com.br, elisangela@central-rnc.com.br
# IRPF2026_ADMIN_EMAILS=ti@central-rnc.com.br,marcelo@central-rnc.com.br,elisangela@central-rnc.com.br

# API Keys (Required to enable respective provider)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"       # Required: Format: sk-ant-api03-...
PERPLEXITY_API_KEY="your_perplexity_api_key_here"     # Optional: Format: pplx-...
OPENAI_API_KEY="your_openai_api_key_here"             # Optional, for OpenAI models. Format: sk-proj-...
GOOGLE_API_KEY="your_google_api_key_here"             # Optional, for Google Gemini models.
MISTRAL_API_KEY="your_mistral_key_here"               # Optional, for Mistral AI models.
XAI_API_KEY="YOUR_XAI_KEY_HERE"                       # Optional, for xAI AI models.
GROQ_API_KEY="YOUR_GROQ_KEY_HERE"                     # Optional, for Groq models.
OPENROUTER_API_KEY="YOUR_OPENROUTER_KEY_HERE"         # Optional, for OpenRouter models.
AZURE_OPENAI_API_KEY="your_azure_key_here"            # Optional, for Azure OpenAI models (requires endpoint in .taskmaster/config.json).
OLLAMA_API_KEY="your_ollama_api_key_here"             # Optional: For remote Ollama servers that require authentication.
GITHUB_API_KEY="your_github_api_key_here"             # Optional: For GitHub import/export features. Format: ghp_... or github_pat_...

# Estudo de Viabilidade (ingestao de legislacao + extracao CNAE via Claude)
# A chave Claude pode estar em CLAUDE_TOKEN_API (preferido neste projeto) ou ANTHROPIC_API_KEY.
# ESTUDO_VIABILIDADE_MAX_FILE_SIZE=26214400              # bytes (default 25 MB)
# ESTUDO_VIABILIDADE_LLM_MODEL=claude-sonnet-4-5-20250929  # modelo Anthropic usado na extracao
# ============================================================================
# OneClick (fonte externa para "Importar Clientes do OneClick")
# ============================================================================
# OneClick de PRODUÇÃO (PostgreSQL na VPS), banco `oneclick`, tabela public.clientes.
# A porta 54322 é publicada só em 127.0.0.1 na VPS → o host do DCTF alcança via
# túnel SSH (ssh -N -L 54322:127.0.0.1:54322 <user>@72.60.155.69).
# Use um role READ-ONLY (ex.: dctf_ro). Ver docs/plano-sync-oneclick-v2.md.
ONECLICK_PG_HOST=127.0.0.1
ONECLICK_PG_PORT=54322
ONECLICK_PG_USER=dctf_ro
ONECLICK_PG_PASSWORD=
ONECLICK_PG_DATABASE=oneclick
# Nome da Tarefa Agendada (Windows) que sobe o túnel; o backend a executa via
# `schtasks /run` quando a porta estiver caída. Ver docs/ONECLICK_TUNNEL_AUTOHEAL.md.
ONECLICK_TUNNEL_TASK=OneClick-DCTF-Tunnel

# ── Cota de aprendizagem / enquadramento de porte ──
# A apuracao e uma so e gera DOIS avisos, com publicos diferentes.
# Sem estas variaveis os dois caem em ti@central-rnc.com.br.
ENQUADRAMENTO_ALERT_EMAILS=ti@central-rnc.com.br
COTA_ALERT_EMAILS=ti@central-rnc.com.br
# Link do botao dos dois e-mails (mesma tela).
COTA_PAGE_URL=http://192.168.0.47:5173/clientes?tab=cota-aprendizagem

# O job mensal roda em tres etapas: cadastro (ReceitaWS) -> faturamento (SCI)
# -> e-mail. `false` pula a etapa de cadastro e apura com o que ja esta gravado.
COTA_REFRESH_CADASTRO=true
# Ritmo da varredura cadastral. 20s = 3 consultas/min, o limite do plano
# gratuito da ReceitaWS. Baixar isso rende HTTP 429 e cliente sem atualizar.
CADASTRO_REFRESH_INTERVALO_MS=20000
