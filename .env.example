# ============================================================================
# DCTF_MPC — variaveis de ambiente
# ============================================================================
# Copie para `.env` e preencha. O `.env` esta no .gitignore: nenhum segredo real
# entra aqui. Senhas, tokens e chaves ficam VAZIOS neste arquivo de exemplo.

# ============================================================================
# Servidor
# ============================================================================
# Porta HTTP do backend. A 3000 foi liberada para o OneClick V2.
PORT=38572
# 0.0.0.0 expoe o backend na rede local (o frontend roda em outra maquina).
HOST=0.0.0.0
# Origem do frontend, usada no CORS e nos links dos e-mails.
FRONTEND_URL=http://192.168.0.47:5173

# ============================================================================
# Banco principal (MySQL)
# ============================================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=DCTF_WEB

# ============================================================================
# Supabase (autenticacao / storage)
# ============================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave de servico — NUNCA exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# SCI (Firebird, somente leitura)
# ============================================================================
# Fonte do faturamento e do codigo SCI dos clientes (view VWGR_SCI_EMPRESAS).
SCI_FB_HOST=192.168.0.2
SCI_FB_DATABASE=S:\SCI\banco\VSCI.SDB
SCI_FB_USER=INTEGRACOES
SCI_FB_PASSWORD=
# Caminho do fbclient.dll, se nao estiver no PATH (usado pelos scripts Python).
# SCI_FB_DLL_PATH=C:\caminho\para\fbclient.dll

# ============================================================================
# E-mail (envio de avisos)
# ============================================================================
EMAIL_USER=
EMAIL_PASSWORD=

# ============================================================================
# OneClick (fonte externa para "Importar Clientes do OneClick")
# ============================================================================
# OneClick de PRODUCAO (PostgreSQL na VPS), banco `oneclick`, tabela public.clientes.
# A porta 54322 e publicada so em 127.0.0.1 na VPS -> o host do DCTF alcanca via
# tunel SSH (ssh -N -L 54322:127.0.0.1:54322 <user>@72.60.155.69).
# Use um role READ-ONLY (ex.: dctf_ro). Ver docs/plano-sync-oneclick-v2.md.
ONECLICK_PG_HOST=127.0.0.1
ONECLICK_PG_PORT=54322
ONECLICK_PG_USER=dctf_ro
ONECLICK_PG_PASSWORD=
ONECLICK_PG_DATABASE=oneclick
# Tenant lido no OneClick (public.clientes.empresa_id). O banco e multi-tenant
# por coluna: alem da Central convivem ali `jrg-empresa` e um tenant de demo.
# Sem esta var vale o default do codigo (Central Contabil).
# ONECLICK_EMPRESA_ID=cmnn7xm6e00009gqgoii3ims2
# Nome da Tarefa Agendada (Windows) que sobe o tunel; o backend a executa via
# `schtasks /run` quando a porta estiver caida. Ver docs/ONECLICK_TUNNEL_AUTOHEAL.md.
ONECLICK_TUNNEL_TASK=OneClick-DCTF-Tunnel

# ============================================================================
# Acessorias (API do Sistema Acessorias)
# ============================================================================
# Doc: https://api.acessorias.com/documentation
# Auth: Bearer token no header Authorization (nao ha endpoint de login).
# O token e gerado no painel da Acessorias: engrenagem (canto sup. direito)
# > "API Token". E POR CONTA — o token de outro escritorio traria a carteira dele.
# Limite: 100 requisicoes/minuto (sliding window); 429 quando estoura.
ACESSORIAS_API_URL=https://api.acessorias.com
ACESSORIAS_API_TOKEN=
# Opcional — so identificacao/auditoria, nao entra na autenticacao.
# Mesmos nomes usados pela integracao do ONECLICK V2
# (ONECLICK V2/apps/api/src/acessorias/acessorias.service.ts), que serve de referencia.
ACESSORIAS_USER=

# ============================================================================
# Cota de aprendizagem / enquadramento de porte
# ============================================================================
# A apuracao e uma so e gera DOIS avisos, com publicos diferentes.
# Sem estas variaveis os dois caem em ti@central-rnc.com.br.
ENQUADRAMENTO_ALERT_EMAILS=ti@central-rnc.com.br
COTA_ALERT_EMAILS=ti@central-rnc.com.br
# Link do botao dos dois e-mails (mesma tela).
COTA_PAGE_URL=http://192.168.0.47:5173/clientes?tab=cota-aprendizagem

# O job mensal roda em tres etapas: cadastro (ReceitaWS) -> faturamento (SCI)
# -> e-mail. `false` pula a etapa de cadastro e apura com o que ja esta gravado.
COTA_REFRESH_CADASTRO=true
# Ritmo da varredura cadastral. 20s = 3 consultas/min, o limite do plano
# gratuito da ReceitaWS. Baixar isso rende HTTP 429 e cliente sem atualizar.
CADASTRO_REFRESH_INTERVALO_MS=20000

# Agendador do job mensal.
COTA_SCHEDULER_ENABLED=true
COTA_SCHEDULER_DIA=1
COTA_SCHEDULER_HORA=8

# ============================================================================
# REOA - conferencia de faturamento do grupo SUBSTITUTO
# ============================================================================
# Limite mensal por estabelecimento. Abaixo disso o cliente entra no aviso.
SUBSTITUTO_THRESHOLD=300000
# Destinatarios do aviso (separados por virgula).
SUBSTITUTO_ALERT_EMAILS=fiscal@central-rnc.com.br,leg@central-rnc.com.br
# Link da pagina no corpo do e-mail.
REOA_PAGE_URL=http://192.168.0.47:5173/beneficios?aba=reoa

# Coleta mensal automatica do SCI + aviso. Sem ela, a janela de 12 meses desliza
# pelo relogio enquanto os dados ficam parados, e a conferencia degrada para
# "sem dados" mes a mes.
REOA_SCHEDULER_ENABLED=true
# Dia 5 e nao dia 1: o mes fechado so aparece no SCI depois dos lancamentos do
# fiscal. Coletar cedo grava mes pela metade e dispara alerta falso.
REOA_SCHEDULER_DIA=5
# 2h para nao concorrer com o job da cota (ambos usam o mesmo lock do SCI).
REOA_SCHEDULER_HORA=2

# ============================================================================
# IRPF 2026
# ============================================================================
# Apenas estes e-mails acessam /irpf-2026/admin (separados por virgula).
# Sem a variavel vale o padrao do codigo (ti@, marcelo@, elisangela@).
# IRPF2026_ADMIN_EMAILS=ti@central-rnc.com.br,marcelo@central-rnc.com.br

# ============================================================================
# Estudo de Viabilidade (ingestao de legislacao + extracao CNAE via Claude)
# ============================================================================
# A chave Claude pode estar em CLAUDE_TOKEN_API (preferido neste projeto) ou
# em ANTHROPIC_API_KEY — o codigo tenta as duas, nessa ordem.
CLAUDE_TOKEN_API=
# ANTHROPIC_API_KEY=
# ESTUDO_VIABILIDADE_MAX_FILE_SIZE=26214400              # bytes (default 25 MB)
# ESTUDO_VIABILIDADE_LLM_MODEL=claude-sonnet-4-5-20250929  # modelo usado na extracao
